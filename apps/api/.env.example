NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (use DATABASE_URL or the individual variables below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nigeria_vtu_platform
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nigeria_vtu_platform
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TTL=30m
